{
  "name": "@tejika/log",
  "version": "0.4.0",
  "description": "Local log files: rotating file sinks and logtape configuration",
  "keywords": [
    "log",
    "logging",
    "logtape",
    "file",
    "rotation"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/TairuFramework/tejika",
    "directory": "packages/log"
  },
  "license": "MIT",
  "sideEffects": false,
  "type": "module",
  "exports": {
    ".": "./lib/index.js"
  },
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "files": [
    "lib/*"
  ],
  "scripts": {
    "build": "pnpm run build:clean && pnpm run build:js && pnpm run build:types",
    "build:clean": "del lib",
    "build:js": "swc src -d ./lib --config-file ../../node_modules/@kigu/dev/swc.json --strip-leading-paths",
    "build:types": "tsc --emitDeclarationOnly --skipLibCheck",
    "build:types:ci": "tsc --emitDeclarationOnly --skipLibCheck --declarationMap false",
    "prepublishOnly": "pnpm run build",
    "test": "pnpm run test:types && pnpm run test:unit",
    "test:types": "tsc --noEmit --skipLibCheck -p tsconfig.test.json",
    "test:unit": "vitest run"
  },
  "dependencies": {
    "@logtape/file": "catalog:",
    "@tejika/env": "workspace:^"
  },
  "devDependencies": {
    "@logtape/logtape": "catalog:",
    "@types/node": "catalog:"
  },
  "peerDependencies": {
    "@logtape/logtape": "catalog:"
  },
  "publishConfig": {
    "access": "public"
  }
}
