{
  "$schema": "./node_modules/turbo/schema.json",
  "tasks": {
    "build:js": {
      "inputs": ["src/**", "package.json", "tsconfig*.json", "$TURBO_ROOT$/tsconfig.build.json"],
      "outputs": ["lib/**/*.js"]
    },
    "build:types": {
      "dependsOn": ["^build:types"],
      "inputs": ["src/**", "package.json", "tsconfig*.json", "$TURBO_ROOT$/tsconfig.build.json"],
      "outputs": ["lib/**/*.d.ts", "lib/**/*.d.ts.map"]
    },
    "test:types": {
      "dependsOn": ["^build:types"],
      "cache": false
    },
    "test": {
      "dependsOn": ["^build:js"],
      "cache": false
    }
  }
}
